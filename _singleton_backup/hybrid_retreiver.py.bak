from __future__ import annotations

import re

from rank_bm25 import BM25Okapi

from RAG.retriever import LegalRetriever


class HybridRetriever:

    def __init__(self):

        # Deferred: ActExtractor.__init__ only needs build_bm25(), which is
        # pure Python. Constructing LegalRetriever here would pull in the
        # 568M-parameter encoder before anyone asks for a vector search.
        self._vector_retriever = None

        self.bm25 = None

        self.chunks = []

    @property
    def vector_retriever(self):
        """
        Built on first use. Backed by the process-level model cache, so
        this is cheap when any other component already loaded the encoder.
        """

        if self._vector_retriever is None:
            self._vector_retriever = LegalRetriever()

        return self._vector_retriever

    def build_bm25(
        self,
        chunks,
    ):

        self.chunks = chunks

        documents = [
            chunk.get(
                "text",
                "",
            )
            for chunk in chunks
        ]

        tokenized_documents = [
            self._tokenize(document)
            for document in documents
        ]

        self.bm25 = BM25Okapi(
            tokenized_documents
        )

    def _tokenize(
        self,
        text: str,
    ):

        return re.findall(
            r"\b(?:u/s|section|sections|act|acts|provisions)\b|"
            r"\d+(?:\([a-zA-Z0-9]+\))*|"
            r"[a-zA-Z]+",
            text.lower(),
        )

    def _legal_reference_score(
        self,
        text: str,
    ):

        text_lower = text.lower()

        score = 0.0

        # ==================================================
        # ACT REFERENCES
        # ==================================================

        if re.search(
            r"\bact\b",
            text_lower,
        ):
            score += 2.0

        if re.search(
            r"\bacts\b",
            text_lower,
        ):
            score += 2.0

        # ==================================================
        # SECTION REFERENCES
        # ==================================================

        if re.search(
            r"\bsection\b",
            text_lower,
        ):
            score += 3.0

        if re.search(
            r"\bsections\b",
            text_lower,
        ):
            score += 3.0

        if re.search(
            r"\bu/s\b",
            text_lower,
        ):
            score += 4.0

        if re.search(
            r"\bunder\s+section\b",
            text_lower,
        ):
            score += 4.0

        # ==================================================
        # SECTION NUMBER
        # ==================================================

        if re.search(
            r"\b\d+(?:\([a-zA-Z0-9]+\))+",
            text_lower,
        ):
            score += 3.0

        # ==================================================
        # ACT + SECTION TOGETHER
        # ==================================================

        if (
            re.search(
                r"\bsection\b.*\bact\b",
                text_lower,
            )
            or
            re.search(
                r"\bu/s\b.*\bact\b",
                text_lower,
            )
            or
            re.search(
                r"\bsection\b.*\bof\b.*\bact\b",
                text_lower,
            )
        ):
            score += 6.0

        # ==================================================
        # PROVISIONS
        # ==================================================

        if re.search(
            r"\bprovisions?\b",
            text_lower,
        ):
            score += 1.5

        return score

    def search(
        self,
        query: str,
        top_k: int = 10,
        document: str | None = None,
    ):

        if self.bm25 is None:

            raise RuntimeError(
                "BM25 index has not been built."
            )

        # ==================================================
        # VECTOR SEARCH
        # ==================================================

        vector_results = (
            self.vector_retriever.search(
                query=query,
                top_k=top_k,
                document=document,
            )
        )

        # ==================================================
        # BM25 SEARCH
        # ==================================================

        query_tokens = self._tokenize(
            query
        )

        bm25_scores = self.bm25.get_scores(
            query_tokens
        )

        ranked_indexes = sorted(
            range(
                len(bm25_scores)
            ),
            key=lambda index:
                bm25_scores[index],
            reverse=True,
        )

        bm25_results = []

        for index in ranked_indexes:

            chunk = self.chunks[index]

            if (
                document is not None
                and chunk.get("document")
                != document
            ):
                continue

            bm25_results.append(
                (
                    chunk,
                    bm25_scores[index],
                )
            )

            if len(
                bm25_results
            ) >= top_k:

                break

        # ==================================================
        # MERGE VECTOR + BM25
        # ==================================================

        candidates = {}

        # --------------------------------------------------
        # VECTOR RESULTS
        # --------------------------------------------------

        for result in vector_results:

            chunk_id = result.payload.get(
                "chunk_id"
            )

            if chunk_id is None:
                continue

            candidates[
                chunk_id
            ] = {
                "chunk": result.payload,
                "vector_score": result.score,
                "bm25_score": 0.0,
            }

        # --------------------------------------------------
        # BM25 RESULTS
        # --------------------------------------------------

        for chunk, bm25_score in bm25_results:

            chunk_id = chunk.get(
                "chunk_id"
            )

            if chunk_id is None:
                continue

            if chunk_id not in candidates:

                candidates[
                    chunk_id
                ] = {
                    "chunk": chunk,
                    "vector_score": 0.0,
                    "bm25_score": bm25_score,
                }

            else:

                candidates[
                    chunk_id
                ]["bm25_score"] = bm25_score

        # ==================================================
        # CALCULATE HYBRID SCORE
        # ==================================================

        scored_results = []

        max_bm25 = 0.0

        for candidate in candidates.values():

            max_bm25 = max(
                max_bm25,
                candidate[
                    "bm25_score"
                ],
            )

        for candidate in candidates.values():

            vector_score = candidate[
                "vector_score"
            ]

            bm25_score = candidate[
                "bm25_score"
            ]

            # Normalize BM25
            if max_bm25 > 0:

                normalized_bm25 = (
                    bm25_score
                    / max_bm25
                )

            else:

                normalized_bm25 = 0.0

            legal_score = (
                self._legal_reference_score(
                    candidate[
                        "chunk"
                    ].get(
                        "text",
                        "",
                    )
                )
            )

            # ==================================================
            # FINAL HYBRID SCORE
            # ==================================================

            final_score = (
                (vector_score * 0.40)
                +
                (normalized_bm25 * 0.30)
                +
                (legal_score * 0.30)
            )

            scored_results.append(
                (
                    final_score,
                    candidate[
                        "chunk"
                    ],
                )
            )

        # ==================================================
        # SORT BEST RESULTS
        # ==================================================

        scored_results.sort(
            key=lambda item:
                item[0],
            reverse=True,
        )

        # ==================================================
        # RETURN QDRANT-LIKE RESULTS
        # ==================================================

        final_results = []

        for score, chunk in scored_results[
            :top_k
        ]:

            class HybridResult:

                def __init__(
                    self,
                    score,
                    payload,
                ):

                    self.score = score

                    self.payload = payload

            final_results.append(
                HybridResult(
                    score=score,
                    payload=chunk,
                )
            )

        return final_results