import threading

import torch
from transformers import AutoTokenizer, AutoModel


DEFAULT_MODEL_NAME = "BAAI/bge-m3"


# ==========================================================
# PROCESS-LEVEL MODEL CACHE
# ==========================================================
#
# bge-m3 is 568M parameters. Loading it costs ~5s even warm, and every
# EmbeddingModel() previously built its own copy. A single pipeline run
# constructed two (once directly, once via LegalRetriever inside
# HybridRetriever), so every document paid the cost twice.
#
# functools.lru_cache would mostly work, but it is not atomic: two
# threads racing on a cold cache both run the loader. Under the FastAPI
# deployment that means two concurrent uploads can each load a copy. The
# lock makes first-load exclusive; the fast path stays a plain dict hit.

_TOKENIZER_CACHE: dict[str, AutoTokenizer] = {}
_MODEL_CACHE: dict[str, "EmbeddingModel"] = {}

_TOKENIZER_LOCK = threading.Lock()
_MODEL_LOCK = threading.Lock()


def get_tokenizer(
    model_name: str = DEFAULT_MODEL_NAME,
) -> AutoTokenizer:
    """
    Shared tokenizer. Safe to call from anywhere, any number of times.
    """

    tokenizer = _TOKENIZER_CACHE.get(model_name)

    if tokenizer is not None:
        return tokenizer

    with _TOKENIZER_LOCK:

        # Re-check: another thread may have loaded it while we waited.
        tokenizer = _TOKENIZER_CACHE.get(model_name)

        if tokenizer is None:
            tokenizer = AutoTokenizer.from_pretrained(model_name)
            _TOKENIZER_CACHE[model_name] = tokenizer

    return tokenizer


def get_embedding_model(
    model_name: str = DEFAULT_MODEL_NAME,
) -> "EmbeddingModel":
    """
    Shared EmbeddingModel. Prefer this over EmbeddingModel() everywhere.

    Constructing EmbeddingModel() directly still works and still loads a
    fresh copy — useful in tests where isolation matters.
    """

    model = _MODEL_CACHE.get(model_name)

    if model is not None:
        return model

    with _MODEL_LOCK:

        model = _MODEL_CACHE.get(model_name)

        if model is None:
            model = EmbeddingModel(model_name)
            _MODEL_CACHE[model_name] = model

    return model


class EmbeddingModel:

    def __init__(
        self,
        model_name: str = DEFAULT_MODEL_NAME,
    ):
        self.model_name = model_name

        self.tokenizer = get_tokenizer(model_name)

        self.model = AutoModel.from_pretrained(
            model_name
        )

        self.model.eval()

    def encode(
        self,
        texts: list[str],
    ):

        inputs = self.tokenizer(
            texts,
            padding=True,
            truncation=True,
            max_length=8192,
            return_tensors="pt",
        )

        with torch.no_grad():

            outputs = self.model(
                **inputs
            )

        embeddings = outputs.last_hidden_state

        attention_mask = inputs[
            "attention_mask"
        ]

        mask = attention_mask.unsqueeze(
            -1
        ).expand(
            embeddings.size()
        ).float()

        embeddings = torch.sum(
            embeddings * mask,
            dim=1,
        ) / torch.clamp(
            mask.sum(dim=1),
            min=1e-9,
        )

        embeddings = torch.nn.functional.normalize(
            embeddings,
            p=2,
            dim=1,
        )

        return embeddings.cpu().numpy()